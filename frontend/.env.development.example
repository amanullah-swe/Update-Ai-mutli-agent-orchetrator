# Chat UI environment — copy to .env.development / .env.production and adjust.

# Base URL of the FastAPI backend (serves /api/chat, /api/health, ...).
VITE_API_BASE_URL=http://localhost:8001

# Which ChatService transport to use:
#   mock — canned streaming reply + simulated failure (no backend needed)
#   sse  — real streaming against POST @ VITE_API_BASE_URL/api/chat (SSE)
VITE_CHAT_TRANSPORT=mock
# Backend environment — copy to backend/.env and adjust.
# Prefix RAG_; values here override configs/<RAG_ENVIRONMENT>.yaml.
RAG_ENVIRONMENT=development
RAG_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag_learning
RAG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RAG_CHAT_PROVIDER=openrouter
RAG_MOCK_TOKEN_DELAY_MS=25
# Real LLM answers via OpenRouter (chat.provider must be `openrouter`):
RAG_LLM_PROVIDER=openrouter
RAG_LLM_MODEL=qwen/qwen3.8-27b:free
RAG_LLM_API_KEY=""        # <your OpenRouter API key> — no default, never committed
# OpenRouter remote embeddings (reuses RAG_LLM_API_KEY by default):
RAG_EMBEDDING_PROVIDER=openrouter
RAG_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
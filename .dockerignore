# ── Frontend ──────────────────────────────────────────────────────────────────
# Installed npm packages — Docker rebuilds these inside the container via npm ci.
frontend/node_modules

# Stale local build output — the builder stage runs npm run build from scratch.
frontend/dist

# ── Backend ───────────────────────────────────────────────────────────────────
# Local Python virtualenv — uv sync --frozen re-creates it inside the image.
backend/.venv

# Editable-install metadata generated by pip/uv locally; not needed in the image.
backend/rag_learning_backend.egg-info

# Python bytecode caches — re-generated at runtime.
**/__pycache__
**/*.pyc
**/*.pyo

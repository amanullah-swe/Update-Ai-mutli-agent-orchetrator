# ── Stage 1: build ────────────────────────────────────────────────────────────
# Use Node LTS (slim) to install deps and compile the Vite/React app.
FROM node:22-slim AS builder

WORKDIR /app

# Copy package files first for layer-cache efficiency.
COPY frontend/package.json frontend/package-lock.json* ./

# Install all deps (dev deps are needed for the build step).
RUN npm ci

# Copy the rest of the frontend source.
COPY frontend/ ./

# Build with production env: API calls are proxied by nginx so the base URL
# is just "/" — nginx forwards /api/* to the backend service.
ENV VITE_API_BASE_URL=""
ENV VITE_CHAT_TRANSPORT=ws

RUN npm run build

# ── Stage 2: serve ────────────────────────────────────────────────────────────
# Serve the compiled static assets with nginx; proxy /api/* to the backend.
FROM nginx:1.27-alpine AS runtime

# Remove the default nginx site config.
RUN rm /etc/nginx/conf.d/default.conf

# Paste in our custom config (see nginx/frontend.conf).
COPY nginx/frontend.conf /etc/nginx/conf.d/frontend.conf

# Copy build output from stage 1.
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
